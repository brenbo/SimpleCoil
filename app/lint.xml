<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- values-en and values-en-r* only hold the strings spelled differently (British vs American), not translations -->
    <issue id="MissingTranslation">
        <ignore regexp="not translated in &quot;en&quot;" />
    </issue>
    <!-- French "one" covers 0 and 1; the plurals there read fine without the number -->
    <issue id="ImpliedQuantity" severity="ignore" />
</lint>
