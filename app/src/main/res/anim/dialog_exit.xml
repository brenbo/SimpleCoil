<?xml version="1.0" encoding="utf-8"?>
<!-- A pop-up going: sinking a little and fading out, quicker than it came -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quad"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="160" />
    <scale android:fromXScale="1" android:toXScale="0.95" android:fromYScale="1" android:toYScale="0.95"
        android:pivotX="50%" android:pivotY="50%" android:duration="160" />
    <translate android:fromYDelta="0" android:toYDelta="4%" android:duration="160" />
</set>
