<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the screen underneath coming forward again -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0.4" android:toAlpha="1" android:duration="280" />
    <translate android:fromXDelta="-6%" android:toXDelta="0" android:duration="280" />
</set>
