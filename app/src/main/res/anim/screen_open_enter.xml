<?xml version="1.0" encoding="utf-8"?>
<!-- A new screen sliding in from the right as it fades in -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <translate android:fromXDelta="12%" android:toXDelta="0" android:duration="320" />
</set>
