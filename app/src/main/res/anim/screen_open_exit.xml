<?xml version="1.0" encoding="utf-8"?>
<!-- The screen underneath easing back a little as the new one comes over it -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0.4" android:duration="320" />
    <translate android:fromXDelta="0" android:toXDelta="-6%" android:duration="320" />
</set>
