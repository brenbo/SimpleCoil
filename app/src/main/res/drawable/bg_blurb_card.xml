<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable blurb card in game mode dialog -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6A1A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sc_surface_highest" />
            <stroke
                android:width="1dp"
                android:color="@color/sc_outline_strong" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
