<?xml version="1.0" encoding="utf-8"?>
<!-- The dialogs' window: a rounded card over the screen; the inset matches AppCompat's own (24dp). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="@dimen/dialog_inset">
    <shape android:shape="rectangle">
        <solid android:color="@color/sc_surface" />
        <corners android:radius="24dp" />
    </shape>
</inset>
