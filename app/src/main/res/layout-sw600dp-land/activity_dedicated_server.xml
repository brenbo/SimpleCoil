<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:id="@+id/main_view"
    tools:context="com.simplecoil.simplecoil.DedicatedServerActivity">

    <!-- Large screens in landscape (the Chromebook): the controls on the left, the scoreboard on
         the right. The same ids and view types as the portrait layout, so the screen's code (and
         its ViewBinding) is the same; hence this RelativeLayout around the panes. -->
    <RelativeLayout
        android:id="@+id/connect_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:fitsSystemWindows="true"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/settings_pane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp">

                    <!-- The game's state and its clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/game_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:text="@string/dedicated_game_waiting"
                            android:textColor="@color/sc_success"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Chronometer
                            android:id="@+id/game_timer_chronometer"
                            style="@style/TextAppearance.SimpleCoil.Value"
                            android:format="%s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/game_countdown_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.SimpleCoil.Value" />
                    </LinearLayout>

                    <!-- Where to join, who's in, and the limits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sc_wifi"
                            app:tint="@color/sc_text_secondary" />

                        <TextView
                            android:id="@+id/server_ip_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.SimpleCoil.Label" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sc_group"
                            app:tint="@color/sc_text_secondary" />

                        <TextView
                            android:id="@+id/player_count_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textAppearance="@style/TextAppearance.SimpleCoil.Label" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/version_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/sc_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/game_limit_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.SimpleCoil.Label"
                        app:drawableStartCompat="@drawable/ic_sc_limits_small"
                        app:drawableTint="@color/sc_text_secondary" />

                    <!-- The one step to the game's next phase: Start, then End, then Reset. The expanded
                         player sheet stops below it. -->
                    <FrameLayout
                        android:id="@+id/phase_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/start_game_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="58dp"
                            android:text="@string/dedicated_start_button"
                            app:icon="@drawable/ic_sc_play"
                            app:iconGravity="textStart" />

                        <Button
                            android:id="@+id/end_game_button"
                            style="@style/Widget.SimpleCoil.Button.Danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="58dp"
                            android:visibility="gone"
                            android:text="@string/dedicated_end_button"
                            app:icon="@drawable/ic_sc_stop"
                            app:iconGravity="textStart" />

                        <Button
                            android:id="@+id/reset_game_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="58dp"
                            android:visibility="gone"
                            android:text="@string/dedicated_reset_button"
                            app:icon="@drawable/ic_sc_replay"
                            app:iconGravity="textStart" />
                    </FrameLayout>

                    <!-- The host walks the players through the blaster, the drops and this game -->
                    <Button
                        android:id="@+id/briefing_button"
                        style="@style/Widget.SimpleCoil.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/briefing_button"
                        app:icon="@drawable/ic_sc_school"
                        app:iconGravity="textStart" />

                    <TextView
                        style="@style/SectionHeading"
                        android:text="@string/dedicated_settings_label" />

                    <!-- The setup as three cards that open in place: Game mode, Field and rules, Teams and
                         players, Extras. Each shows a one-line summary; the rest is one tap deeper. -->
                    <LinearLayout
                        android:id="@+id/settings_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Game mode: the one choice every game needs, with the game limit, starting timer and saved setups. -->
                        <LinearLayout
                            style="@style/ServerDropCard"
                            android:id="@+id/mode_card"
                            android:layout_marginTop="6dp">

                            <LinearLayout
                                style="@style/ServerCardHeader"
                                android:id="@+id/mode_card_header">

                                <ImageView
                                    style="@style/ServerCardIcon"
                                    android:src="@drawable/ic_sc_target" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ServerCardTitle"
                                        android:text="@string/server_card_mode" />

                                    <TextView
                                        style="@style/ServerCardSummary"
                                        android:id="@+id/mode_summary_tv" />
                                </LinearLayout>

                                <TextView
                                    style="@style/ServerCardChevron"
                                    android:id="@+id/mode_chevron_tv" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/mode_body"
                                style="@style/ServerDropBody">

                            <Button
                                android:id="@+id/mode_change_button"
                                style="@style/Widget.SimpleCoil.Button.Tonal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:text="@string/server_mode_change"
                                app:icon="@drawable/ic_sc_target"
                                app:iconGravity="textStart" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/game_limit_button"
                                    style="@style/Widget.SimpleCoil.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:maxLines="1"
                                    app:autoSizeMaxTextSize="14sp"
                                    app:autoSizeMinTextSize="9sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:text="@string/game_limit_button" />

                                <Button
                                    android:id="@+id/starting_timer_button"
                                    style="@style/Widget.SimpleCoil.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:maxLines="1"
                                    app:autoSizeMaxTextSize="14sp"
                                    app:autoSizeMinTextSize="9sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:text="@string/starting_timer_button" />

                                <Button
                                    android:id="@+id/presets_button"
                                    style="@style/Widget.SimpleCoil.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:maxLines="1"
                                    app:autoSizeMaxTextSize="14sp"
                                    app:autoSizeMinTextSize="9sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:text="@string/game_presets_button" />
                            </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Field and rules: the map (border, spawns, capture points, photo), whose GPS is heard
                             (map design: Field imagery packs), and the rules and extras (out of bounds, respawn,
                             ammo, drops, killstreaks, shot distance). Tap to open. -->
                        <LinearLayout
                            style="@style/ServerDropCard"
                            android:id="@+id/field_card">

                            <LinearLayout
                                style="@style/ServerCardHeader"
                                android:id="@+id/field_card_header">

                                <ImageView
                                    style="@style/ServerCardIcon"
                                    android:src="@drawable/ic_sc_map" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ServerCardTitle"
                                        android:text="@string/server_card_field" />

                                    <TextView
                                        style="@style/ServerCardSummary"
                                        android:id="@+id/field_map_status_tv"
                                        android:text="@string/field_map_status_none" />

                                    <TextView
                                        style="@style/ServerCardSummary"
                                        android:id="@+id/extras_summary_tv" />
                                </LinearLayout>

                                <TextView
                                    style="@style/ServerCardChevron"
                                    android:id="@+id/field_chevron_tv" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/field_body"
                                style="@style/ServerDropBody">

                            <!-- Whose GPS the server hears from: a player without a fix has no shot distances, drops,
                                 spawns or capture points -->
                            <TextView
                                style="@style/ServerCardSummary"
                                android:id="@+id/server_gps_tv"
                                                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/field_map_button"
                                    style="@style/Widget.SimpleCoil.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="@string/field_map_button"
                                    app:icon="@drawable/ic_sc_map"
                                    app:iconGravity="textStart" />

                                <Button
                                    android:id="@+id/field_rules_button"
                                    style="@style/Widget.SimpleCoil.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/field_rules"
                                    app:icon="@drawable/ic_sc_rules"
                                    app:iconGravity="textStart" />
                            </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Teams and players: tap to open. Team and GPS modes as segmented controls, so every choice
                             and the current one are in view, then who may join and choose. -->
                        <LinearLayout
                            style="@style/ServerDropCard"
                            android:id="@+id/teams_card">

                            <LinearLayout
                                style="@style/ServerCardHeader"
                                android:id="@+id/teams_card_header">

                                <ImageView
                                    style="@style/ServerCardIcon"
                                    android:src="@drawable/ic_sc_group" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ServerCardTitle"
                                        android:text="@string/server_card_teams" />

                                    <TextView
                                        style="@style/ServerCardSummary"
                                        android:id="@+id/teams_summary_tv" />
                                </LinearLayout>

                                <TextView
                                    style="@style/ServerCardChevron"
                                    android:id="@+id/teams_chevron_tv" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/teams_body"
                                style="@style/ServerDropBody">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="0dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="@string/team_mode_label"
                                    android:textAppearance="@style/TextAppearance.SimpleCoil.Label" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButtonToggleGroup
                                        android:id="@+id/team_mode_group"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        app:selectionRequired="true"
                                        app:singleSelection="true">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/team_mode_2teams_button"
                                            style="@style/ServerSegment"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="@string/team_mode_2teams" />

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/team_mode_4teams_button"
                                            style="@style/ServerSegment"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="@string/team_mode_4teams" />

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/team_mode_ffa_button"
                                            style="@style/ServerSegment"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="@string/team_mode_ffa_short" />
                                    </com.google.android.material.button.MaterialButtonToggleGroup>

                                    <Button
                                        android:id="@+id/sort_teams_button"
                                        style="@style/Widget.SimpleCoil.Button.Outlined"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="@string/shuffle_teams_button"
                                        app:icon="@drawable/ic_sc_shuffle"
                                        app:iconTint="@color/sc_text" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="@string/gps_mode_label"
                                    android:textAppearance="@style/TextAppearance.SimpleCoil.Label" />

                                <com.google.android.material.button.MaterialButtonToggleGroup
                                    android:id="@+id/gps_mode_group"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/gps_mode_disabled_button"
                                        style="@style/ServerSegment"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/gps_mode_disabled" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/gps_mode_teammate_button"
                                        style="@style/ServerSegment"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/gps_mode_teammate" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/gps_mode_all_button"
                                        style="@style/ServerSegment"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/gps_mode_all" />
                                </com.google.android.material.button.MaterialButtonToggleGroup>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/allow_join_switch"
                                    style="@style/DialogSwitch"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/dedicated_allow_join" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/only_server_settings_switch"
                                    style="@style/DialogSwitch"
                                    android:text="@string/dedicated_server_settings_only" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/allow_choose_teams_switch"
                                    style="@style/DialogSwitch"
                                    android:text="@string/dedicated_allow_choose_teams" />

                                <!-- Push-to-talk to teammates: off unless turned on -->
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/voice_chat_switch"
                                    style="@style/DialogSwitch"
                                    android:text="@string/dedicated_voice_chat" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Drag to size the panes either side -->
            <com.simplecoil.simplecoil.ui.server.PaneDivider
                android:id="@+id/divider_left"
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <!-- Who's playing; the button fills the window with them -->
            <LinearLayout
                android:id="@+id/players_pane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_sheet_title"
                        android:textAppearance="@style/TextAppearance.SimpleCoil.Label" />

                    <ImageButton
                        android:id="@+id/players_expand_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pane_fullscreen"
                        app:srcCompat="@drawable/ic_sc_fullscreen" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/player_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
