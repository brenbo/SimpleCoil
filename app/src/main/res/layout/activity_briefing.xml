<?xml version="1.0" encoding="utf-8"?>
<!-- The host's briefing: one slide at a time (the blaster, the drops, the game), the same on every
     phone. The host's screen adds the controls; the players' can't be closed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/briefing_section_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="@color/sc_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="YOUR BLASTER" />

    <!-- The slide moves as a whole when the next one comes in -->
    <LinearLayout
        android:id="@+id/briefing_slide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.simplecoil.simplecoil.ui.briefing.BriefingArtView
            android:id="@+id/briefing_art"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/briefing_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/sc_text"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="Trigger" />

        <TextView
            android:id="@+id/briefing_body_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/sc_text"
            android:textSize="19sp"
            tools:text="Pull it to shoot." />
    </LinearLayout>

    <TextView
        android:id="@+id/briefing_progress_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/sc_text_muted"
        android:textSize="13sp"
        tools:text="3 of 12" />

    <!-- The host only -->
    <LinearLayout
        android:id="@+id/briefing_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/briefing_close_button"
            style="@style/Widget.SimpleCoil.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/briefing_close" />

        <Button
            android:id="@+id/briefing_skip_button"
            style="@style/Widget.SimpleCoil.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="@string/briefing_skip" />

        <Button
            android:id="@+id/briefing_next_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/briefing_next" />
    </LinearLayout>
</LinearLayout>
