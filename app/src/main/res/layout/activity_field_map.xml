<?xml version="1.0" encoding="utf-8"?>
<!-- The dedicated server's field map (map design: Field imagery packs, Border, Field presets):
     find the field, draw its border, set the out-of-bounds rules, download its photo for the
     phones, and save it all as a preset. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.maplibre.android.maps.MapView
        android:id="@+id/field_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capture points, drawn over the map at their real size; taps go through to the map. -->
    <FrameLayout
        android:id="@+id/field_objectives_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/field_hint_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:padding="8dp"
        android:text="@string/field_map_hint"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/field_status_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/field_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/field_border_label"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/field_tool_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/field_tool_circle_button"
                style="@style/ServerSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_tool_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/field_tool_polygon_button"
                style="@style/ServerSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_tool_polygon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/field_tool_walk_button"
                style="@style/ServerSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_tool_walk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/field_tool_spawns_button"
                style="@style/ServerSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_tool_spawns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/field_tool_objectives_button"
                style="@style/ServerSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_tool_objectives" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- With the Spawns tool: which team a tap adds a spawn for, and Auto-place. -->
        <LinearLayout
            android:id="@+id/field_spawn_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/field_spawn_team_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/field_auto_place_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="@string/field_auto_place" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/field_undo_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="@string/field_undo" />

            <Button
                android:id="@+id/field_clear_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/field_clear" />

            <Button
                android:id="@+id/field_presets_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="@string/field_presets" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/field_my_location_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="@string/field_map_my_location" />

            <Button
                android:id="@+id/field_download_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/field_map_download" />

            <Button
                android:id="@+id/field_delete_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="@string/field_map_delete" />
        </LinearLayout>

        <TextView
            android:id="@+id/field_credit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_credit_short"
            android:textColor="#AAFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
