<?xml version="1.0" encoding="utf-8"?>
<!-- The dedicated server's live referee map (map design: Dedicated server settings, "during a
     game"): every player, the field, and what the mode has on it, with the referee's controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/ref_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_renderTextureMode="true" />
    <!-- (Texture mode: the map resizes in step with its pane as it grows, and is clipped to the
         pane's rounded corners) -->

    <FrameLayout
        android:id="@+id/ref_objectives_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ref_drops_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ref_flags_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ref_players_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ref_names_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The imagery's credit, as on every map (moved up over the referee's controls when they show) -->
    <TextView
        android:id="@+id/ref_credit_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="#990E1116"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/sc_text"
        android:textSize="11sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/ref_info_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B30E1116"
        android:padding="8dp"
        android:textColor="@color/sc_text"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/ref_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D90E1116"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            style="@style/Widget.SimpleCoil.Button.Compact"
            android:id="@+id/ref_drop_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="@string/ref_drop_now" />

        <Button
            style="@style/Widget.SimpleCoil.Button.Compact"
            android:id="@+id/ref_zone_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="@string/ref_close_zone"
            android:visibility="gone" />

        <Button
            style="@style/Widget.SimpleCoil.Button.Compact"
            android:id="@+id/ref_end_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="@string/ref_end_game" />
    </LinearLayout>
</FrameLayout>
