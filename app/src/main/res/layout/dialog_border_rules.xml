            android:id="@+id/rules_claim_radius_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/DialogSwitch"
            android:id="@+id/rules_nearest_team_switch"
            android:text="@string/rules_nearest_team" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_shield_hits_et"
            android:text="@string/rules_shield_hits" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_shield_hits_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_uav_seconds_et"
            android:text="@string/rules_uav_seconds" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_uav_seconds_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/DialogSwitch"
            android:id="@+id/rules_killstreaks_switch"
            android:text="@string/rules_killstreaks" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_uav_kills_et"
            android:text="@string/rules_uav_kills" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_uav_kills_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_auto_kills_et"
            android:text="@string/rules_auto_kills" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_auto_kills_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <com.google.android.material.materialswitch.MaterialSwitch
