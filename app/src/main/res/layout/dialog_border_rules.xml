        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_enemy_clear_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_crossfade_et"
            android:text="@string/rules_crossfade" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_crossfade_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_old_grace_et"
            android:text="@string/rules_old_grace" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_old_grace_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <com.google.android.material.materialswitch.MaterialSwitch
