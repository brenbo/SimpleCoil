            android:text="@string/rules_units" />

        <RadioGroup
            android:id="@+id/rules_units_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_units_feet"
                android:text="@string/rules_units_feet" />

            <RadioButton
