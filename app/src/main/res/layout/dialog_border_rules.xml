        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_per_team_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_enemy_share_et"
            android:text="@string/rules_enemy_spawn_share" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_enemy_share_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
