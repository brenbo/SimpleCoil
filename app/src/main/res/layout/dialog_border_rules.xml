<?xml version="1.0" encoding="utf-8"?>
<!-- The out-of-bounds rules (map design: Border, GPS limits), styled like the game limit and
     player settings dialogs. Distances are in the chosen units. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sc_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/rules_title_tv"
            style="@style/DialogTitle"
            android:text="@string/rules_title" />

        <LinearLayout
            android:id="@+id/rules_field_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/DialogSection"
            android:text="@string/rules_section_penalty" />

        <View style="@style/DialogDivider" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/rules_penalty" />

        <RadioGroup
            android:id="@+id/rules_penalty_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_penalty_disable"
                android:text="@string/rules_penalty_disable" />

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_penalty_health"
                android:text="@string/rules_penalty_health" />

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_penalty_eliminate"
                android:text="@string/rules_penalty_eliminate" />

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_penalty_warning"
                android:text="@string/rules_penalty_warning" />
        </RadioGroup>

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_countdown_et"
            android:text="@string/rules_countdown" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_countdown_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_health_et"
            android:text="@string/rules_health_per_tick" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_health_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_tick_et"
            android:text="@string/rules_tick_seconds" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_tick_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogSection"
            android:text="@string/rules_section_respawn" />

        <View style="@style/DialogDivider" />

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/DialogSwitch"
            android:id="@+id/rules_walk_back_switch"
            android:text="@string/rules_walk_back" />

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/DialogSwitch"
            android:id="@+id/rules_start_at_spawn_switch"
            android:text="@string/rules_start_at_spawn" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_seconds_in_spawn_et"
            android:text="@string/rules_seconds_in_spawn" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_seconds_in_spawn_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            style="@style/DialogLabel"
            android:id="@+id/rules_spawn_radius_label"
            android:labelFor="@+id/rules_spawn_radius_et"
            android:text="@string/rules_spawn_radius" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/rules_spawn_radius_et"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            style="@style/DialogLabel"
            android:labelFor="@+id/rules_per_team_et"
