            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/DialogSwitch"
            android:id="@+id/rules_drops_switch"
            android:text="@string/rules_drops" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/rules_drop_kinds" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_supply"
            android:text="@string/drop_name_supply" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_burst"
            android:text="@string/drop_name_burst" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_ammo"
            android:text="@string/drop_name_ammo" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_medkit"
            android:text="@string/drop_name_medkit" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_life"
            android:text="@string/drop_name_life" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_shield"
            android:text="@string/drop_name_shield" />

        <CheckBox
            style="@style/DialogRadio"
            android:id="@+id/rules_drop_uav"
