            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_post_off"
                android:text="@string/rules_post_off" />

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_post_kills"
                android:text="@string/rules_post_kills" />

            <RadioButton
                style="@style/DialogRadio"
                android:id="@+id/rules_post_full"
                android:text="@string/rules_post_full" />
        </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rules_gps_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/DialogSection"
            android:text="@string/rules_section_gps" />

        <View style="@style/DialogDivider" />

        <TextView
