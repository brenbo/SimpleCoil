            <EditText
                style="@style/DialogField"
                android:id="@+id/ex_collect_et"
                android:digits="0123456789"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2" />

            <TextView
                style="@style/DialogLabel"
                android:id="@+id/ex_opens_label"
