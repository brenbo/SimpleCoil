<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#080808"
    android:padding="8dp" >

    <!-- After a Domination or Hardpoint game: Victory or Defeat, animated in, over confetti for a win. -->
    <FrameLayout
        android:id="@+id/game_result_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:visibility="gone">

        <com.simplecoil.simplecoil.ui.scoreboard.ConfettiView
            android:id="@+id/game_result_confetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/game_result_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:shadowColor="#CC000000"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_result_score_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- After a game on a dedicated server: the kills, a heat map and a replay. -->
    <Button
        android:id="@+id/post_map_button"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/post_open"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/player_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#080808" />

    <!-- The score matrix face: the grid, or progress, or a message. GONE while the list shows. -->
    <FrameLayout
        android:id="@+id/score_matrix_face"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/score_matrix_min_height"
        android:visibility="gone" >

        <com.simplecoil.simplecoil.ui.scoreboard.ScoreMatrixView
            android:id="@+id/score_matrix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fadeScrollbars="true"
            android:scrollbars="horizontal|vertical"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/score_matrix_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            style="@style/DialogBody"
            android:id="@+id/score_matrix_message"
            android:layout_marginTop="0dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The longest shots face: each player's longest shot this game, ranked. -->
    <FrameLayout
        android:id="@+id/longest_shots_face"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/score_matrix_min_height"
        android:visibility="gone" >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <LinearLayout
                android:id="@+id/longest_shots_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/longest_shots_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            style="@style/DialogBody"
            android:id="@+id/longest_shots_message"
            android:layout_marginTop="0dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
