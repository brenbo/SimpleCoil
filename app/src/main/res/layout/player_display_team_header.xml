<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/sc_surface_high"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/team_header_color_sq"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/team_header_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="TEAM 1"
        android:textColor="@color/sc_on_orange_container"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/team_header_action_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scoreboard_edit_ratio"
        android:textColor="@color/sc_text_secondary"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Voice chat: mute (or hear again) the whole team on this phone -->
    <ImageView
        android:id="@+id/team_mute_iv"
        android:contentDescription="@string/cd_mute_team"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:src="@drawable/ic_voice_on"
        android:visibility="gone" />

</LinearLayout>
