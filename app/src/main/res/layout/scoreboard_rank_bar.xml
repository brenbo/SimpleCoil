<?xml version="1.0" encoding="utf-8"?>
<!-- The scoreboard's rank-by dropdown: winning team (or squad) first, or best player first -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rank_by_label"
        android:textAppearance="@style/TextAppearance.SimpleCoil.Secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rank_by_choice_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_rank_by"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:textColor="@color/sc_orange"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
