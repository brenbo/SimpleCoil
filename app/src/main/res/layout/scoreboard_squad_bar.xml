<?xml version="1.0" encoding="utf-8"?>
<!-- Squad mode, on the server: Create squad, or while one is being edited what to do and Done -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/squad_bar_hint_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.SimpleCoil.Secondary"
        android:textSize="13sp" />

    <!-- Editing a squad: break it up, its players back to playing alone -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/squad_bar_delete_button"
        style="@style/Widget.SimpleCoil.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/squad_delete"
        android:textColor="@color/sc_danger"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/squad_bar_button"
        style="@style/Widget.SimpleCoil.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:icon="@drawable/ic_squad_add"
        app:iconTint="@null" />
</LinearLayout>
