<?xml version="1.0" encoding="utf-8"?>
<!-- The icon art whole, as the background layer (it doesn't move with the launcher's parallax);
     the line-drawn crosshair is for themed (one-colour) icons and the notification icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art"/>
    <foreground android:drawable="@android:color/transparent"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
